{
  "name": "mcp-authkit-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for mcp-authkit — a framework for adding OAuth + PAT auth to MCP servers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkmorendha/mcp-authkit.git"
  },
  "homepage": "https://github.com/omkmorendha/mcp-authkit#readme",
  "bugs": {
    "url": "https://github.com/omkmorendha/mcp-authkit/issues"
  },
  "author": "Om Morendha",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "bash e2e/python/run.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.7"
  }
}
