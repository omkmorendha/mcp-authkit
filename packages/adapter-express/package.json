  "type": "module",
  "description": "Express adapter for mcp-authkit — mounts MCP, metadata, and PAT handlers as Express middleware.",
  "license": "MIT",
  "author": "Om Morendha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkmorendha/mcp-authkit.git",
