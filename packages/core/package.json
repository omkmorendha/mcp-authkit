{
  "name": "mcp-authkit",
  "version": "0.1.0",
  "type": "module",
  "description": "OAuth + PAT auth for MCP servers — token validation pipeline, scope matcher, PAT lifecycle, audit dispatch.",
  "license": "MIT",
  "author": "Om Morendha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkmorendha/mcp-authkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/omkmorendha/mcp-authkit#readme",
  "bugs": {
    "url": "https://github.com/omkmorendha/mcp-authkit/issues"
  },
  "keywords": [
    "mcp",
    "oauth",
    "auth",
    "pat",
    "authkit",
    "model-context-protocol"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory.d.ts",
      "import": "./dist/stores/memory.js"
    },
    "./stores/postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "import": "./dist/stores/postgres.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.type-test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.2.3",
    "mcp-authkit-adapter-express": "workspace:*",
    "mcp-authkit-store-memory": "workspace:*",
    "mcp-authkit-store-postgres": "workspace:*",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.0"
  }
}
